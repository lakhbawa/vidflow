{
  "name": "VidFlow API",
  "api_id": "vidflow-api",
  "org_id": "vidflow",
  "use_keyless": true,
  "auth": {
    "auth_header_name": "Authorization"
  },
  "definition": {
    "location": "header",
    "key": "version"
  },
  "version_data": {
    "not_versioned": true,
    "versions": {
      "Default": {
        "name": "Default"
      }
    }
  },
  "proxy": {
    "listen_path": "/api/",
    "target_url": "http://vidflow-api:8000/",
    "strip_listen_path": true
  },
  "active": true
}