FROM golang:1.25-alpine

WORKDIR /app

# Install system dependencies (Alpine uses apk, not apt)
RUN apk add --no-cache \
    ffmpeg \
    gcc \
    musl-dev

# Copy go module files
COPY go.mod go.sum ./

RUN go mod download

# Copy the remaining source code
COPY . .

CMD ["go", "run", "cmd/api/main.go"]